# Copy to .env (git-ignored) only if you want to make real paid calls.
# Use a dedicated, low-balance hot wallet holding a little USDC on Base.
# Never put a main wallet key here and never commit a real key.
#
# Load it into your shell before running an example (bash/zsh):
#   set -a; . ./.env; set +a
# Node 20.6+ can also read it directly:  node --env-file=../.env meridian.mjs pay
EVM_PRIVATE_KEY=

# Set to exactly 1 to allow the examples to sign and send a real x402 payment.
MERIDIAN_PAY=0

# Per-payment spend cap in US DOLLARS. The "$" prefix is required and the single quotes keep
# the shell from expanding it. Bare numbers (atomic units) are rejected. Hard maximum: '$0.10'
# (the batch screen needs '$0.10').
MERIDIAN_MAX_PER_CALL='$0.02'

# Optional: save the full Meridian-Receipt (it contains a bearer id) to this file, mode 0600.
# MERIDIAN_RECEIPT_FILE=./receipt.json
